PORT=3001
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=hidraulica_db

# Token exigido no cabeçalho x-admin-token para cadastrar bombas (POST /api/bombas).
# Deixe vazio para manter o cadastro desativado.
ADMIN_TOKEN=

# Origens autorizadas a chamar a API, separadas por vírgula. Vazio = qualquer origem.
CORS_ORIGIN=
